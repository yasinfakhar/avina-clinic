FROM node:22.23.0-bookworm-slim AS dependencies
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm rebuild @node-rs/argon2

FROM node:22.23.0-bookworm-slim AS runtime
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787
WORKDIR /app
RUN groupadd --system --gid 10001 avina && useradd --system --uid 10001 --gid avina --home-dir /nonexistent --shell /usr/sbin/nologin avina
COPY --from=dependencies --chown=avina:avina /app/node_modules ./node_modules
COPY --chown=avina:avina server/index.mjs server/schema.sql ./server/
USER avina
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:8787/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "server/index.mjs"]
