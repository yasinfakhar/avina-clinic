{
  "name": "avina-audiology-desktop",
  "productName": "Avina Audiology",
  "description": "Offline desktop management system for an audiology clinic",
  "author": "Avina Audiology",
  "version": "1.1.10",
  "private": true,
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev -p 5173",
    "desktop:dev": "electron .",
    "build": "next build",
    "build:desktop": "npm run release:validate && npm run build && node scripts/prepare-electron-build.mjs && electron-builder --win nsis --x64",
    "release:windows": "node scripts/export-windows-release.mjs",
    "build:desktop:dir": "npm run build && node scripts/prepare-electron-build.mjs && electron-builder --win --x64 --dir",
    "build:windows:zip": "bash scripts/build-windows-zip.sh",
    "release:validate": "node scripts/validate-release.mjs",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "backup": "node scripts/backup.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "electron-updater": "^6.6.2",
    "next": "16.2.6",
    "node-machine-id": "^1.1.12",
    "puppeteer-core": "^25.9.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "ir.avina.audiology",
    "productName": "Avina Audiology",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/electron-standalone",
        "to": "standalone"
      },
      {
        "from": "electron/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "artifactName": "Avina-Audiology-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/avina-logo.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://licence.sayahub.ir/avina/update/windows"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.medical",
      "hardenedRuntime": true
    }
  }
}
